# Copie este arquivo para `.env` e ajuste os valores se precisar.
# Com o banco SQLite (padrão), não é necessário configurar nada para rodar.

# Chave secreta das sessions Flask (obrigatória em produção)
SECRET_KEY=sua-chave-secreta-muito-longa-e-aleatoria

# Opcional: override da URI do banco. Padrão: sqlite:///sparkly.db
# DATABASE_URL=sqlite:///sparkly.db
